# ==============================================================================
# OpenMail Verify Environment Configuration
# ==============================================================================
PROJECT_NAME="OpenMail Verify API"
API_V1_STR="/api/v1"
DATABASE_URL="sqlite:///./verification_history.db"
ENABLE_HISTORY_LOGGING=true
DNS_TIMEOUT_SECONDS=3.0
DNS_LIFETIME_SECONDS=5.0
MAX_BATCH_SIZE=50

# Mailbox Verification / OTP Configuration
OTP_EXPIRATION_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ==============================================================================
# OUTBOUND SMTP EMAIL DELIVERY CONFIGURATION
# To send actual verification codes to recipient inboxes, configure your SMTP
# credentials below and rename/copy this file to .env (or backend/.env)
# ==============================================================================

# Common Examples:
#
# --- GMAIL (Using Google App Password) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USERNAME="your-gmail-address@gmail.com"
# SMTP_PASSWORD="your-16-character-app-password"   # (Generate in Google Account -> Security -> App Passwords)
# SMTP_FROM_EMAIL="your-gmail-address@gmail.com"
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
#
# --- OUTLOOK / OFFICE 365 ---
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT=587
# SMTP_USERNAME="your-email@outlook.com"
# SMTP_PASSWORD="your-password"
# SMTP_FROM_EMAIL="your-email@outlook.com"
# SMTP_USE_TLS=true
#
# --- SENDGRID ---
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USERNAME="apikey"
# SMTP_PASSWORD="your-sendgrid-api-key"
# SMTP_FROM_EMAIL="verified-sender@yourdomain.com"
# SMTP_USE_TLS=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
